PORT=4100

DB_HOST=localhost
DB_PORT=3306
DB_USER=root
DB_PASSWORD=
DB_DATABASE=mitienda

# Id de la tienda que atiende esta API (la de datos_demo.sql es la 1)
TIENDA_ID=1

# Dirección del frontend (React con Vite usa el 5173)
CORS_ORIGIN=http://localhost:5173

# Cadena larga y aleatoria. Generala con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=

# ---------- Recuperar contraseña ----------
# Dirección del frontend, para armar el link que va en el email (por defecto usa CORS_ORIGIN)
# FRONTEND_URL=http://localhost:5173

# Envío de emails (OPCIONAL). Si lo dejás vacío, el link de recuperación
# se imprime en la terminal del backend: ideal para desarrollo.
# Con Gmail: activá la verificación en 2 pasos y creá una "contraseña de aplicación".
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_USER=tucuenta@gmail.com
# SMTP_PASS=contraseña-de-aplicacion
# MAIL_FROM="Mi Tienda <tucuenta@gmail.com>"

# ---------- Mercado Pago (OPCIONAL) ----------
# Credenciales en https://www.mercadopago.com.ar/developers → tu aplicación → Credenciales de prueba.
# Usá primero las de PRUEBA: en el panel, menú "Credenciales de prueba" → Access Token.
# (Hoy también empiezan con APP_USR-; lo que importa es que estés en la pestaña de PRUEBA.)
# Nunca subas este archivo a GitHub.
# MP_ACCESS_TOKEN=APP_USR-xxxxxxxxxxxxxxxx
# Clave secreta de la sección Webhooks de tu aplicación (para comprobar que el aviso viene de Mercado Pago)
# MP_WEBHOOK_SECRET=
# Dirección pública https de esta API. Mercado Pago no puede avisar a localhost:
# en desarrollo usá un túnel (por ejemplo: ngrok http 4100) y pegá acá su dirección https.
# Si lo dejás vacío, el pago se confirma igual cuando el cliente vuelve a la tienda.
# BACKEND_URL=https://algo.ngrok-free.app
